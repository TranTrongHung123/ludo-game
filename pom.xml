<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>vn.ptit.ltm</groupId>
    <artifactId>ludo-game</artifactId>
    <version>1.0-SNAPSHOT</version>

    <packaging>pom</packaging>

    <modules>
        <module>common</module>
        <module>server</module>
    </modules>

    <properties>
        <!-- Java -->
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependencies -->
        <jackson.version>2.22.2</jackson.version>

        <mysql.version>9.7.0</mysql.version>
        <hikari.version>7.1.0</hikari.version>
        <flyway.version>12.3.0</flyway.version>

        <slf4j.version>2.0.18</slf4j.version>
        <logback.version>1.5.38</logback.version>

        <jbcrypt.version>0.4</jbcrypt.version>

        <junit.version>5.14.4</junit.version>
        <mockito.version>5.23.0</mockito.version>
        <maven.surefire.version>3.5.4</maven.surefire.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
