<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="vn.ptit.ltm.client.controller.LobbyController"
            styleClass="app-background">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="top-bar">
            <VBox HBox.hgrow="ALWAYS" spacing="3.0">
                <Label fx:id="welcomeLabel" styleClass="screen-title"/>
                <Label fx:id="scoreLabel" styleClass="screen-subtitle"/>
            </VBox>
            <Label fx:id="connectionLabel" styleClass="connection-offline"/>
            <Button fx:id="logoutButton" onAction="#handleLogout" styleClass="secondary-button" text="Đăng xuất"/>
        </HBox>
    </top>
    <center>
        <HBox spacing="22.0">
            <padding>
                <Insets bottom="28.0" left="32.0" right="32.0" top="28.0"/>
            </padding>
            <VBox spacing="12.0" styleClass="content-card" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="section-title" text="Người chơi online" HBox.hgrow="ALWAYS"/>
                    <Button onAction="#handleRefresh" styleClass="secondary-button" text="Làm mới"/>
                </HBox>
                <ListView fx:id="onlinePlayersList" VBox.vgrow="ALWAYS"/>
            </VBox>
            <VBox maxWidth="330.0" minWidth="300.0" spacing="14.0" styleClass="content-card">
                <Label styleClass="section-title" text="Phòng chơi"/>
                <Label maxWidth="280.0" styleClass="screen-subtitle"
                       text="Tạo phòng mới hoặc nhập mã phòng do chủ phòng chia sẻ."
                       wrapText="true"/>
                <Button fx:id="createRoomButton" maxWidth="Infinity" onAction="#handleCreateRoom"
                        styleClass="primary-button" text="Tạo phòng"/>
                <Label styleClass="field-label" text="Mã phòng"/>
                <TextField fx:id="roomIdField" promptText="Nhập mã phòng"/>
                <Button fx:id="joinRoomButton" maxWidth="Infinity" onAction="#handleJoinRoom"
                        styleClass="secondary-button" text="Tham gia"/>
                <VBox fx:id="invitationBox" managed="false" spacing="9.0" styleClass="invitation-card"
                      visible="false">
                    <Label styleClass="field-label" text="Lời mời mới"/>
                    <Label fx:id="invitationLabel" maxWidth="280.0" wrapText="true"/>
                    <HBox spacing="8.0">
                        <Button fx:id="acceptInvitationButton" onAction="#handleAcceptInvitation"
                                styleClass="primary-button" text="Chấp nhận"/>
                        <Button fx:id="rejectInvitationButton" onAction="#handleRejectInvitation"
                                styleClass="secondary-button" text="Từ chối"/>
                    </HBox>
                </VBox>
                <Label fx:id="feedbackLabel" minHeight="42.0" wrapText="true"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
