<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Rectangle2D?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>

<Pane fx:id="loginRoot" prefHeight="912.0" prefWidth="1672.0" styleClass="login-background-root"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vn.ptit.ltm.client.controller.LoginController">
    <children>
        <Group fx:id="scaledContent" managed="false">
            <children>
                <ImageView fitHeight="912.0" fitWidth="1672.0" mouseTransparent="true" preserveRatio="false">
                    <image>
                        <Image url="@/images/login.png"/>
                    </image>
                    <viewport>
                        <Rectangle2D height="912.0" minX="0.0" minY="29.0" width="1672.0"/>
                    </viewport>
                </ImageView>

                <Pane prefHeight="912.0" prefWidth="1672.0">
                    <TextField fx:id="usernameField" layoutX="972.0" layoutY="334.0"
                               onAction="#handleLogin" prefHeight="50.0" prefWidth="410.0"
                               promptText="Nhập tên đăng nhập" styleClass="login-background-input"/>

                    <PasswordField fx:id="passwordField" layoutX="972.0" layoutY="435.0"
                                   onAction="#handleLogin" prefHeight="50.0" prefWidth="380.0"
                                   promptText="Nhập mật khẩu"
                                   styleClass="login-background-input, login-background-password"/>
                    <TextField fx:id="visiblePasswordField" layoutX="972.0" layoutY="435.0"
                               onAction="#handleLogin" prefHeight="50.0" prefWidth="380.0"
                               promptText="Nhập mật khẩu"
                               styleClass="login-background-input, login-background-password"
                               visible="false"/>
                    <Button fx:id="passwordVisibilityButton" accessibleText="Hiện mật khẩu"
                            layoutX="1351.0" layoutY="435.0" mnemonicParsing="false"
                            onAction="#togglePasswordVisibility" prefHeight="50.0" prefWidth="51.0"
                            styleClass="login-password-toggle"/>

                    <CheckBox fx:id="rememberCheckBox" layoutX="916.0" layoutY="505.0"
                              mnemonicParsing="false" prefHeight="36.0" prefWidth="214.0"
                              selected="true" styleClass="login-background-remember" text="Ghi nhớ đăng nhập"/>
                    <Button accessibleText="Quên mật khẩu" layoutX="1270.0" layoutY="506.0"
                            mnemonicParsing="false" onAction="#showPasswordRecoveryNotice"
                            prefHeight="36.0" prefWidth="140.0" styleClass="login-image-hotspot"/>

                    <Label fx:id="feedbackLabel" alignment="CENTER" layoutX="920.0" layoutY="538.0"
                           prefHeight="23.0" prefWidth="486.0" styleClass="login-overlay-feedback"
                           visible="false" wrapText="true"/>

                    <Button fx:id="loginButton" accessibleText="Đăng nhập" defaultButton="true"
                            layoutX="920.0" layoutY="562.0" mnemonicParsing="false"
                            onAction="#handleLogin" prefHeight="69.0" prefWidth="486.0"
                            styleClass="login-image-submit"/>
                    <Button accessibleText="Đăng ký ngay" layoutX="1168.0" layoutY="657.0"
                            mnemonicParsing="false" onAction="#showRegister"
                            prefHeight="38.0" prefWidth="132.0" styleClass="login-image-hotspot"/>

                    <Label fx:id="connectionLabel" alignment="CENTER" layoutX="920.0" layoutY="714.0"
                           prefHeight="55.0" prefWidth="486.0"
                           styleClass="login-background-connection, connection-offline"/>
                    <Button fx:id="retryButton" layoutX="920.0" layoutY="714.0" managed="false"
                            mnemonicParsing="false" onAction="#retryConnection"
                            prefHeight="55.0" prefWidth="486.0" styleClass="login-background-retry"
                            text="Kết nối lại Game Server" visible="false"/>
                </Pane>
            </children>
        </Group>
    </children>
</Pane>
