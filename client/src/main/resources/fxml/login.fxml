<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="vn.ptit.ltm.client.controller.LoginController"
            styleClass="app-background">
    <left>
        <VBox alignment="CENTER_LEFT" prefWidth="410.0" spacing="18.0" styleClass="brand-panel">
            <padding>
                <Insets bottom="64.0" left="56.0" right="56.0" top="64.0"/>
            </padding>
            <Label styleClass="brand-kicker" text="PTIT • LẬP TRÌNH MẠNG"/>
            <Label maxWidth="310.0" styleClass="brand-title" text="Ludo Game" wrapText="true"/>
            <Label maxWidth="300.0" styleClass="brand-copy"
                   text="Cờ Cá Ngựa nhiều người chơi với Game Server làm trọng tài trung tâm."
                   wrapText="true"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label styleClass="brand-footnote" text="TCP • JSON • JavaFX"/>
        </VBox>
    </left>
    <center>
        <VBox alignment="CENTER" styleClass="content-panel">
            <VBox maxWidth="390.0" spacing="14.0" styleClass="auth-card">
                <Label styleClass="eyebrow" text="CHÀO MỪNG TRỞ LẠI"/>
                <Label styleClass="screen-title" text="Đăng nhập"/>
                <Label styleClass="screen-subtitle" text="Kết nối với Game Server để vào sảnh chờ." wrapText="true"/>

                <Label styleClass="field-label" text="Tên đăng nhập"/>
                <TextField fx:id="usernameField" onAction="#handleLogin" promptText="Nhập tên đăng nhập"/>

                <Label styleClass="field-label" text="Mật khẩu"/>
                <PasswordField fx:id="passwordField" onAction="#handleLogin" promptText="Nhập mật khẩu"/>

                <Label fx:id="feedbackLabel" minHeight="22.0" wrapText="true"/>
                <Button fx:id="loginButton" defaultButton="true" maxWidth="Infinity" onAction="#handleLogin"
                        styleClass="primary-button" text="Đăng nhập"/>
                <Button fx:id="retryButton" managed="false" maxWidth="Infinity" onAction="#retryConnection"
                        styleClass="secondary-button" text="Kết nối lại" visible="false"/>

                <HBox alignment="CENTER" spacing="4.0">
                    <Label text="Chưa có tài khoản?"/>
                    <Hyperlink onAction="#showRegister" text="Đăng ký ngay"/>
                </HBox>
                <Label fx:id="connectionLabel" alignment="CENTER" maxWidth="Infinity" styleClass="connection-offline"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
