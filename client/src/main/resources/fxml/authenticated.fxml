<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="vn.ptit.ltm.client.controller.AuthenticatedController"
            styleClass="app-background">
    <center>
        <VBox alignment="CENTER" spacing="16.0">
            <padding>
                <Insets bottom="64.0" left="64.0" right="64.0" top="64.0"/>
            </padding>
            <VBox alignment="CENTER" maxWidth="560.0" spacing="12.0" styleClass="welcome-card">
                <Label styleClass="eyebrow" text="ĐĂNG NHẬP THÀNH CÔNG"/>
                <Label fx:id="welcomeLabel" styleClass="screen-title"/>
                <Label fx:id="usernameLabel" styleClass="screen-subtitle"/>
                <Label fx:id="scoreLabel" styleClass="stat-line"/>
                <Label maxWidth="430.0" styleClass="screen-subtitle"
                       text="Client đã nhận session và hồ sơ từ Server. Giao diện Lobby đầy đủ sẽ được nối ở bước tiếp theo."
                       textAlignment="CENTER" wrapText="true"/>
                <Label fx:id="feedbackLabel" minHeight="22.0" wrapText="true"/>
                <Button fx:id="logoutButton" onAction="#handleLogout" styleClass="secondary-button" text="Đăng xuất"/>
                <Label fx:id="connectionLabel" styleClass="connection-offline"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
