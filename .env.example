# Copy this file to .env only when you need to override local defaults.
MYSQL_DATABASE=ludo_game
MYSQL_USER=ludo
MYSQL_PASSWORD=ludo_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_PORT=3306
TZ=Asia/Ho_Chi_Minh

# Optional Game Server database overrides (configure these in the IDE/run environment).
# DB_URL=jdbc:mysql://localhost:3306/ludo_game?useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=SERVER
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=ludo_game
# DB_USER=ludo
# DB_PASSWORD=ludo_dev_password
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT_MS=10000

# Game Server
SERVER_PORT=5555
SERVER_WORKER_THREADS=32

# JavaFX Client (configure these in the IDE/run environment).
SERVER_HOST=127.0.0.1
